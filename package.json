{
  "name": "tony-next-starter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "node scripts/setup-template.mjs",
    "template:init": "node scripts/setup-template.mjs",
    "template:clean": "node scripts/setup-template.mjs --clean-example --yes",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "api:generate": "node scripts/generate-api.mjs",
    "api:check": "node scripts/check-api-freshness.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "verify:e2e": "pnpm verify && pnpm test:e2e",
    "ci": "pnpm verify && pnpm test:e2e"
  },
  "dependencies": {
    "@heroui/react": "^3.2.6",
    "@heroui/styles": "^3.2.6",
    "@hookform/resolvers": "^3.10.0",
    "@internationalized/date": "^3.12.4",
    "@react-aria/ssr": "^3.10.1",
    "@react-aria/utils": "^3.34.1",
    "@tanstack/react-query": "^5.67.0",
    "@tanstack/react-table": "^8.21.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.477.0",
    "motion": "^12.4.7",
    "next": "^16.4.0",
    "next-themes": "^0.4.4",
    "nuqs": "^2.4.0",
    "react": "^19.0.0",
    "react-aria": "^3.52.1",
    "react-aria-components": "^1.21.1",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.2",
    "tailwind-merge": "^3.0.2",
    "zod": "^3.24.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@hey-api/client-fetch": "^0.13.1",
    "@hey-api/openapi-ts": "^0.99.0",
    "@playwright/test": "^1.50.1",
    "@storybook/addon-essentials": "^8.6.4",
    "@storybook/nextjs": "^10.6.1",
    "@storybook/react": "^10.6.1",
    "@storybook/react-vite": "10.6.1",
    "@tailwindcss/postcss": "^4.0.9",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.6.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-config-next": "^16.0.0",
    "jsdom": "^30.1.2",
    "msw": "^3.0.2",
    "postcss": "^8.5.3",
    "prettier": "^3.5.2",
    "storybook": "^10.6.1",
    "tailwindcss": "^4.0.9",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.3"
  }
}
