# Server-only Environment Variables (Never expose to client!)
API_URL=http://localhost:3000/api
# OpenAPI Specification source: local file path OR remote HTTP/HTTPS URL
OPENAPI_SPEC_PATH=./openapi/spec.json
# OPENAPI_SPEC_URL=http://localhost:3001/openapi.json
# OPENAPI_SPEC=https://api.example.com/openapi.json
AUTH_SECRET=super-secret-development-key-min-32-chars

# Public Environment Variables (Safe for client browser)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Tony Next Starter"
